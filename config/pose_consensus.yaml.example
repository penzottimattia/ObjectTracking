world_frame: world

consensus:
  translation_tolerance_m: 0.05
  rotation_tolerance_deg: 10.0
  min_cameras: 2
  failures_before_reset: 3
  # Optional: x, y, z, or null. Canonicalizes this object-frame axis in every
  # camera overlay as well as in the fused published pose.
  force_align_axis: null
  # If true, the selected axis is treated as an unoriented line (+axis and
  # -axis are equivalent). The least disruptive branch is selected, avoiding
  # automatic 180-degree flips of the other axes on symmetric objects.
  soft_force_align: false

# world_T_camera transforms. Replace these example values with calibration results.
cameras:
  robotcam:
    world_T_camera:
      translation: {x: 0.0, y: 0.0, z: 1.0}
      rotation_xyzw: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}
  tablecam:
    world_T_camera:
      translation: {x: 1.0, y: 0.0, z: 1.0}
      rotation_xyzw: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}
